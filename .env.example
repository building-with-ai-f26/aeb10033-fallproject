# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional: which OpenRouter model reads your recipes.
# Default is anthropic/claude-haiku-5.5 (about $0.002 per recipe in Build 1 tests).
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional: PostHog analytics (pageviews, clicks, session replay) in the local app.
# Use the "Project token" / "Project API key" starting with phc_ (public by design).
# Never use a Personal API key (phx_...) here.
# POSTHOG_KEY=phc_your-project-key
# POSTHOG_HOST=https://us.i.posthog.com

# Live site only (set these in Render's Environment tab, not needed locally):
# HOST=0.0.0.0                 lets the internet reach the app (local default 127.0.0.1)

# Supabase, required (Project Settings > API Keys / Data API in the Supabase dashboard).
# The publishable key is safe to share with browsers. NEVER put the secret key (sb_secret_...) here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Optional: most AI recipe reads per account in 24 hours (default 30).
# DAILY_AI_LIMIT=30
