#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional: which OpenRouter model reads your recipes.
# Default is anthropic/claude-haiku-5.5 (about $0.002 per recipe in Build 1 tests).
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
